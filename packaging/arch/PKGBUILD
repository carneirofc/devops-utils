# Maintainer: carneirofc <claudiofcarneiro@gmail.com>
#
# Builds the committed HEAD of $PKG_SOURCE: scripts/package.sh sets it to this checkout
# (and runs makepkg on a copy of this directory); plain `makepkg` builds GitHub.

pkgname=devops-utils-git
_name=devops-utils
pkgver=0.13.0.r0.gee27374
pkgrel=1
pkgdesc="DevOps utilities: Kubernetes manifest sanitizing and Azure DevOps work items as a CLI, TUI, Qt UI and MCP server"
arch=('any')
url="https://github.com/carneirofc/devops-utils"
license=('MIT')
depends=('python' 'python-click' 'python-yaml')
# Each extra of pyproject.toml, by the command that needs it.
optdepends=(
  'python-httpx: devops-utils azdo (Azure DevOps)'
  'python-textual: devops-utils-tui'
  'pyside6: devops-utils-qt'
  'python-mcp: devops-utils-mcp (needs mcp >= 2)'
)
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs' 'python-wheel')
checkdepends=('python-pytest')
provides=('devops-utils')
conflicts=('devops-utils')
source=("$_name::git+${PKG_SOURCE:-$url.git}")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  # Releases are tagged without a v: 0.13.0-5-gabc1234 -> 0.13.0.r5.gabc1234
  git describe --tags --long --abbrev=7 --match '[0-9]*' | sed 's/\([^-]*-\)g/r\1g/;s/-/./g'
}

build() {
  cd "$_name"
  # hatch-vcs takes the version from the clone's tags.
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name"
  # The suites that need no optional extra; the full one needs `uv sync --all-extras`.
  PYTHONPATH=src python -m pytest -q -p no:cacheprovider \
    tests/test_sanitizer.py tests/test_envfile.py tests/test_select.py tests/test_encoding.py \
    tests/test_setup.py tests/test_plugin.py tests/test_cli_azdo_confirmation.py
}

package() {
  cd "$_name"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
